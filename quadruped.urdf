    </inertial>
    <visual>
      <geometry>
        <cylinder length="0.05" radius="0.02"/>
      </geometry>
      <material name="green"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.05" radius="0.02"/>
      </geometry>
    </collision>
  </link>

  <!-- Rear Left Knee -->
  <joint name="rl_knee_joint" type="revolute">
