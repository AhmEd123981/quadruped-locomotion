"""
Training script for Behavior Cloning (BC) stage.
Pre-trains the policy using expert demonstrations.
"""

import argparse
import os
import pickle
from pathlib import Path

import numpy as np
import torch
import torch.nn as nn
import torch.optim as optim
import yaml
from stable_baselines3 import PPO
from stable_baselines3.common.evaluation import evaluate_policy
from stable_baselines3.common.callbacks import CheckpointCallback, EvalCallback

from src.envs.quadruped_env import QuadrupedEnv
from src.utils.data_loader import load_demonstrations


def parse_args():
    parser = argparse.ArgumentParser(description='Train BC model')
    parser.add_argument('--config', type=str, required=True,
                        help='Path to config file')
    parser.add_argument('--demo-path', type=str, required=True,
                        help='Path to expert demonstrations')
    parser.add_argument('--output-dir', type=str, default='models/bc_baseline',
                        help='Output directory for model checkpoints')
    parser.add_argument('--seed', type=int, default=42,
                        help='Random seed')
    parser.add_argument('--device', type=str, default='auto',
                        help='Device to use (cpu/cuda/auto)')
    return parser.parse_args()


def load_config(config_path):
    """Load configuration from YAML file."""
    with open(config_path, 'r') as f:
        config = yaml.safe_load(f)
    return config


def train_bc_with_ppo(env, expert_obs, expert_actions, config, output_dir, device):
    """Train BC using supervised learning with PPO policy network."""
    
    # Get policy kwargs and convert activation function
    policy_kwargs = config.get('bc_params', {}).get('policy_kwargs', {})
    
    # Convert activation function string to actual function
    if 'activation_fn' in policy_kwargs:
        activation_name = policy_kwargs['activation_fn']
        if activation_name == 'relu':
            policy_kwargs['activation_fn'] = nn.ReLU
        elif activation_name == 'tanh':
            policy_kwargs['activation_fn'] = nn.Tanh
        elif activation_name == 'elu':
            policy_kwargs['activation_fn'] = nn.ELU
        else:
            # Default to ReLU if unknown
            policy_kwargs['activation_fn'] = nn.ReLU
    
    # Create PPO model (we'll only use the policy network)
    model = PPO(
        'MlpPolicy',
        env,
        device=device,
        policy_kwargs=policy_kwargs,
        verbose=0
    )
    
    # Get policy network
    policy = model.policy
    optimizer = optim.Adam(
        policy.parameters(), 
        lr=config.get('bc_params', {}).get('learning_rate', 1e-3)
    )
    criterion = nn.MSELoss()
    
    # Training parameters
    n_epochs = config.get('n_epochs', 100)
    batch_size = config.get('batch_size', 64)
    log_interval = config.get('log_interval', 10)
    
    # Convert to tensors
    if device == 'cuda':
        expert_obs_tensor = torch.FloatTensor(expert_obs).cuda()
        expert_actions_tensor = torch.FloatTensor(expert_actions).cuda()
    else:
        expert_obs_tensor = torch.FloatTensor(expert_obs)
        expert_actions_tensor = torch.FloatTensor(expert_actions)
    
    dataset_size = len(expert_obs)
    
    print(f"Starting BC training for {n_epochs} epochs...")
    print(f"Dataset size: {dataset_size}")
    print(f"Batch size: {batch_size}")
    print(f"Learning rate: {optimizer.param_groups[0]['lr']}")
    
    best_loss = float('inf')
    
    for epoch in range(n_epochs):
        epoch_losses = []
    
        # Shuffle data
        indices = torch.randperm(dataset_size)
    
        # Training loop
        policy.train()
        for i in range(0, dataset_size, batch_size):
            batch_indices = indices[i:min(i+batch_size, dataset_size)]
            batch_obs = expert_obs_tensor[batch_indices]
            batch_actions = expert_actions_tensor[batch_indices]
        
            # Forward pass through the full policy
            predicted_actions, _, _ = policy(batch_obs, deterministic=True)
        
            # Compute loss
            loss = criterion(predicted_actions, batch_actions)
        
            #Backward pass
            optimizer.zero_grad()
            loss.backward()
            optimizer.step()
        
            epoch_losses.append(loss.item())
    
        avg_loss = np.mean(epoch_losses)
    
        if (epoch + 1) % log_interval == 0:
            print(f"Epoch {epoch+1}/{n_epochs} - Avg Loss: {avg_loss:.6f}")
    
        # Save best model
       if avg_loss < best_loss:
           best_loss = avg_loss
        model.save(str(output_dir / 'best_model.zip'))
        if (epoch + 1) % log_interval == 0:
            print(f"  → New best model saved! (Loss: {best_loss:.6f})")
            
            # Compute loss
            loss = criterion(predicted_actions, batch_actions)
            
            # Backward pass
            optimizer.zero_grad()
            loss.backward()
            optimizer.step()
            
            epoch_losses.append(loss.item())
        
        avg_loss = np.mean(epoch_losses)
        
        if (epoch + 1) % log_interval == 0:
            print(f"Epoch {epoch+1}/{n_epochs} - Avg Loss: {avg_loss:.6f}")
        
        # Save best model
        if avg_loss < best_loss:
            best_loss = avg_loss
            model.save(str(output_dir / 'best_model.zip'))
            if (epoch + 1) % log_interval == 0:
                print(f"  → New best model saved! (Loss: {best_loss:.6f})")
    
    print(f"\nTraining complete! Best loss: {best_loss:.6f}")
    
    return model


def main():
    args = parse_args()
    
    # Load configuration
    config = load_config(args.config) print(f"Loaded configuration from {args.config}")
    
    # Set seeds for reproducibility
    np.random.seed(args.seed)
    torch.manual_seed(args.seed)
    if torch.cuda.is_available():
        torch.cuda.manual_seed(args.seed)
    
    # Create output directory
    output_dir = Path(args.output_dir)
    output_dir.mkdir(parents=True, exist_ok=True)
    
    # Save configuration
    with open(output_dir / 'config.yaml', 'w') as f:
        yaml.dump(config, f)
    
    # Create environment
    print("Creating environment...")
    env_params = config.get('env_params', {})
    env_params.pop('render', None)  # Remove render if it exists
    
    env = QuadrupedEnv(
        render=config.get('render', False),
        **env_params
    )
    
    # Create evaluation environment
    eval_env_params = config.get('env_params', {})
    eval_env_params.pop('render', None)
    
    eval_env = QuadrupedEnv(
        render=False,
        **eval_env_params
    )
    
    # Load expert demonstrations
    print(f"Loading demonstrations from {args.demo_path}...")
    demonstrations = load_demonstrations(args.demo_path)
    print(f"Loaded {len(demonstrations)} demonstration episodes")
    
    # Extract observations and actions
    expert_obs = []
    expert_actions = []
    
    for episode in demonstrations:
        expert_obs.extend(episode['observations'])
        expert_actions.extend(episode['actions'])
    
    expert_obs = np.array(expert_obs, dtype=np.float32)
    expert_actions = np.array(expert_actions, dtype=np.float32)
    
    print(f"Total transitions: {len(expert_obs)}")
    print(f"Observation shape: {expert_obs.shape}")
    print(f"Action shape: {expert_actions.shape}")
    
    # Determine device
    if args.device == 'auto':
        device = 'cuda' if torch.cuda.is_available() else 'cpu'
    else:
        device = args.device
    
    print(f"Using device: {device}")
    
    # Train BC model
    print("\n" + "="*50)
    print("STARTING BEHAVIOR CLONING TRAINING")
    print("="*50 + "\n")
    
    model = train_bc_with_ppo(
        env, 
        expert_obs, 
        expert_actions, 
        config, 
        output_dir, 
        device
    )
    
    # Save final model
    final_model_path = output_dir / 'final_model.zip'
    model.save(str(final_model_path))
    print(f"\nSaved final model to {final_model_path}")
    
    # Evaluate final model
    print("\n" + "="*50)
    print("EVALUATING TRAINED MODEL")
    print("="*50 + "\n")
    
    mean_reward, std_reward = evaluate_policy(
        model,
        eval_env,
        n_eval_episodes=config.get('n_eval_episodes', 10),
        deterministic=True
    )
    
    print(f"\nEvaluation Results:")
    print(f"  Mean reward: {mean_reward:.2f} +/- {std_reward:.2f}")
    
    # Save evaluation results
    results = {
        'mean_reward': float(mean_reward),
        'std_reward': float(std_reward),
        'config': config,
        'seed': args.seed
    }
    
    with open(output_dir / 'results.yaml', 'w') as f:
        yaml.dump(results, f)
    
    print(f"\nResults saved to {output_dir / 'results.yaml'}")
    print("\n" + "="*50)
    print("BC TRAINING COMPLETE!")
    print("="*50 + "\n")
    
    env.close()
    eval_env.close()


if __name__ == '__main__':
    main()
