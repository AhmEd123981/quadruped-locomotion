    <limit effort="100" velocity="10" lower="-3.14159" upper="3.14159"/>
  </joint>
  <link name="fr_knee_link">
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder length="0.05" radius="0.015"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.05" radius="0.015"/>
      </geometry>
    </collision>
  </link>

  <!-- Front Right Ankle -->
  <joint name="fr_ankle_joint" type="revolute">
    <parent link="fr_knee_link"/>
    <child link="fr_foot_link"/>
    <origin xyz="0 0 -0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" velocity="10" lower="-3.14159" upper="3.14159"/>
  </joint>
  <link name="fr_foot_link">
