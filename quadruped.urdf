        <sphere radius="0.025"/>
      </geometry>
    </collision>
  </link>

  <!-- Rear Right Hip -->
  <joint name="rr_hip_joint" type="revolute">
    <parent link="base_link"/>
    <child link="rr_hip_link"/>
    <origin xyz="-0.15 -0.12 -0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" velocity="10" lower="-3.14159" upper="3.14159"/>
  </joint>
  <link name="rr_hip_link">
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder length="0.05" radius="0.02"/>
      </geometry>
      <material name="green"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.05" radius="0.02"/>
      </geometry>
    </collision>
