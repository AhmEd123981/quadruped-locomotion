    <parent link="rr_hip_link"/>
    <child link="rr_knee_link"/>
    <origin xyz="0 0 -0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" velocity="10" lower="-3.14159" upper="3.14159"/>
  </joint>
  <link name="rr_knee_link">
    <inertial>
